# Every setting is optional: with none the lab starts in Mock, mints the three tokens and rehearses against an in-process stand-in.
# Copy to .env beside docker-compose.yml (gitignored, kept out of the image). From a clone with `npm start`, the SPIFFE_* keys may
# instead live in the one shared settings file ~/Development/.env (STANDALONE_ENV overrides the path); the environment wins over it.
# After editing: docker compose up -d. No secret is needed: the JWT-SVID is the credential and the signing keys are generated by the lab.

# --- Real: needed to present the tokens to a Privilege gateway (all three) -------------------------------------------------
# The public https origin where THIS lab's /.well-known/ is reachable by the gateway (a tunnel or the SE cluster; see the README).
# The issuer string in every token is exactly this origin. No path, no trailing detail.
PUBLIC_URL=https://<your-public-origin>
# The Privilege gateway origin, and the door (MCP app) names: the door is <origin>/<app>/mcp and is also the token audience.
SPIFFE_GW_URL=https://<gateway-host>
SPIFFE_GW_APPS=<app-name>

# --- Optional -------------------------------------------------------------------------------------------------------------
# SPIFFE_TRUST_DOMAIN=lab.example     # spiffe://<trust-domain>/ns/<namespace>/sa/<agent>
# SPIFFE_NAMESPACE=agents
# SPIFFE_AGENT=mcp-agent              # the workload the VALID token names (the Federated Identity's Subject)
# SPIFFE_OTHER_AGENT=other-agent      # the workload the MISMATCHED token names
# SPIFFE_TTL_SECONDS=120              # token lifetime, 1-300 (capped at 300)
# SPIFFE_ALG=RS256                    # RS256 (default) or ES256
# SPIFFE_UNTRUSTED=key                # key: right claims, unpublished key. issuer: also a different iss
# SPIFFE_AUD_ARRAY=0                  # 1: send aud as an array, as SPIRE does
# SPIFFE_AUDIENCE=                    # override the audience (default <SPIFFE_GW_URL>/<app>/mcp)
# SHELF_URL=http://127.0.0.1:4400

# --- Optional: test a SPIRE you run yourself (the SPIRE card on the Settings page) ------------------------------------------
# Unset = the card tests the local demo SPIRE (Docker, from a clone). Set = it tests THIS instead and starts nothing.
# A path prefix is fine (https://spire.example/spire). Use the origin your SPIRE's OIDC discovery provider is published at.
# SPIRE_SERVER_URL=https://<your-spire-host>[/<prefix>]
# SPIRE_AGENT_URL=https://<agent-or-health-origin>             # optional extra reachability check
# SPIRE_ALLOWED_HOSTS=https://<other-origin-that-serves-keys>  # optional: other origins the key URL may live on (comma separated)
